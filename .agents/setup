#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

# CI pins Bun 1.4.2; older Bun (1.3.x) hangs on this lockfile.
BUN_VERSION=1.4.2
if [ "$(bun --version 2>/dev/null || true)" != "$BUN_VERSION" ]; then
  echo "==> install bun $BUN_VERSION"
  curl -fsSL https://bun.sh/install | bash -s "bun-v$BUN_VERSION"
fi
export PATH="$HOME/.bun/bin:$PATH"
grep -qs '.bun/bin' ~/.bash_profile || echo 'export PATH="$HOME/.bun/bin:$PATH"' >> ~/.bash_profile

echo "==> bun install"
time bun install --frozen-lockfile
