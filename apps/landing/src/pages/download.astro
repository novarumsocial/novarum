---
import '../styles/global.css';
import Footer from '../components/Footer.astro';

const releases = 'https://github.com/novarumsocial/novarum/releases';
// nightly.link serves the latest artifact of a workflow on a branch, without needing a GitHub login
const nightly = 'https://nightly.link/novarumsocial/novarum/workflows/native-development-release/main';

// Phosphor icons (regular)
const icons = {
