            >
              {features[0].description}
            </p>

            <div
              class="mt-8 grid min-h-52 flex-1 place-items-center rounded-[2rem] border-2 border-gray-900 bg-gray-100 p-6 text-center text-xl dark:border-gray-200 dark:bg-gray-900 sm:text-2xl"
