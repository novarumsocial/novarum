    <script>
      const featureTabs = document.querySelector('[data-feature-tabs]');

      if (featureTabs) {
        const tabs = [...featureTabs.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
        const fields = {
          title: featureTabs.querySelector('[data-feature-title]'),
          tagline: featureTabs.querySelector('[data-feature-tagline]'),
          description: featureTabs.querySelector('[data-feature-description]'),
          demo: featureTabs.querySelector('[data-feature-demo]'),
        };

        const selectTab = (tab: HTMLButtonElement) => {
          tabs.forEach((item) => {
            const selected = item === tab;
            item.setAttribute('aria-selected', String(selected));
            item.tabIndex = selected ? 0 : -1;
          });

          Object.entries(fields).forEach(([name, element]) => {
            if (element) element.textContent = tab.dataset[name] ?? '';
          });
        };

        featureTabs.addEventListener('click', (event) => {
          const tab = (event.target as Element).closest<HTMLButtonElement>('[role="tab"]');
          if (tab) selectTab(tab);
        });

        featureTabs.addEventListener('keydown', (event) => {
          if (!(event instanceof KeyboardEvent) || !['ArrowDown', 'ArrowUp'].includes(event.key)) return;
          const current = tabs.indexOf(document.activeElement as HTMLButtonElement);
          if (current < 0) return;
          event.preventDefault();
          const offset = event.key === 'ArrowDown' ? 1 : -1;
          const next = tabs[(current + offset + tabs.length) % tabs.length];
          selectTab(next);
          next.focus();
        });
      }
    </script>
  </body>
</html>

<style>
  .feature-tab:hover,
  .feature-tab[aria-selected='true'] {
    background: var(--sl-color-white);
    color: var(--sl-color-black);
    transform: translateX(0.25rem);
  }

  .sun {
    transform-box: view-box;
    transform-origin: 12px 10px;
  }

  /* idk why link styles are like this but it should do it */
  * {
    text-decoration: none;
  }

  @keyframes sunrise {
    from {
      transform: translateY(9px);
    }

    to {
      transform: translateY(0);
    }
  }
</style>
