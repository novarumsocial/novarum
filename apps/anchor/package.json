{
  "name": "anchor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./notification-level": {
      "types": "./utils/notificationLevel.ts",
      "import": "./utils/notificationLevel.ts"
    },
    "./public-user": {
      "types": "./utils/publicUser.ts",
      "import": "./utils/publicUser.ts"
    }
  },
  "module": "src/index.js",
  "scripts": {
    "bench": "bun run benchmarks/run.ts",
    "bench:compare": "bun run benchmarks/compare.ts",
    "build": "bun build --compile --target bun --outfile ../../testing/server src/index.ts",
    "db:generate": "bunx --bun drizzle-kit generate",
    "db:migrate": "bunx --bun drizzle-kit migrate",
    "db:push": "bunx --bun drizzle-kit push",
    "dev": "bun run --watch src/index.ts",
    "email": "email dev --dir src/emails",
    "check": "tsc --noEmit -p .",
    "test": "ANCHOR_CONFIG=test/config.toml bun test test/unit test/integration",
    "db:pushfix": "bun run ./src/db/fix-push.ts",
    "test:unit": "ANCHOR_CONFIG=test/config.toml bun test test/unit",
    "test:integration": "ANCHOR_CONFIG=test/config.toml bun test test/integration",
    "test:fed": "bun test/federation/run.ts",
    "test:migrations": "ANCHOR_CONFIG=test/config.toml bun test test/migrations",
    "test:infra": "docker compose -f test/compose.yml up -d --wait"
  },
  "dependencies": {
    "@elysia/openapi": "^1.4.15",
    "@elysiajs/cors": "^1.4.2",
    "@leeoniya/ufuzzy": "^1.0.19",
    "@react-email/components": "^1.0.12",
    "aws4fetch": "^1.0.20",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "elysia": "^1.4.29",
    "elysia-ip": "^1.1.1",
    "elysia-rate-limit": "^4.6.2",
    "fast-average-color-node": "^3.2.0",
    "livekit-server-sdk": "^2.15.5",
    "node-av": "^6.1.1",
    "nodemailer": "^9.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-email": "^6.9.1",
    "sharp": "^0.35.3",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@elysia/eden": "^1.4.10",
    "@react-email/ui": "6.9.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.6.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/web-push": "^3.6.4",
    "bun-types": "latest",
    "drizzle-kit": "^1.0.0-rc.4"
  },
  "packageManager": "bun@1.4.2"
}
