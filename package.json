{
  "name": "novarum",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "docker compose -f dev/compose.yml up -d -t 0 && bun run --parallel --filter '*' dev",
    "format": "git diff --name-only -z --diff-filter=ACMR HEAD | xargs -0 bun oxfmt",
    "format:check": "oxfmt --check",
    "format:all": "oxfmt",
    "anchor:docker": "depot build -f apps/anchor/Dockerfile -t ghcr.io/novarumsocial/anchor:latest --push .",
    "anchor:push": "docker push ghcr.io/novarumsocial/anchor:latest",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.58.0",
    "prettier-plugin-svelte": "^4.1.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "workspaces": [
    "apps/*"
  ],
  "trustedDependencies": [
    "electron"
  ]
}
